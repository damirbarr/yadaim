# ─────────────────────────────────────────────────────────────────────────────
# Local development needs NONE of these: `npm run dev` uses an embedded Postgres
# (PGlite in ./data/pglite), loads demo data, and skips sign-in (dev mode).
# Copy to .env.local only for the variables you want to change.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL — used in OAuth redirects and in WhatsApp links (worker pages, campaign tracking)
APP_URL=http://localhost:3000

# ── Database (Supabase Postgres in production) ──
# Use the "Transaction pooler" connection string (port 6543) on Vercel.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Run the schema on every boot (default: on for PGlite, off for DATABASE_URL — use `npm run db:migrate` instead)
# DB_AUTO_MIGRATE=0
# Load demo data when the users table is empty (default: on for PGlite, off for DATABASE_URL)
# SEED_DEMO=0

# ── Google sign-in through Supabase Auth ──
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# ── File storage (worker photos & documents) — Supabase Storage, private bucket ──
# SUPABASE_SERVICE_ROLE_KEY=<service role key — server only, never expose>
# SUPABASE_BUCKET=uploads

# ── Access control ──
# Comma-separated emails that become platform admins on first Google sign-in
# ADMIN_EMAILS=you@example.com
# Dev mode (no sign-in). Defaults: on in `next dev`, off in production. Set 1 only for a throwaway demo deployment.
# AUTH_DEV_BYPASS=0
